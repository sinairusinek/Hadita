         /**
          * Return to library view
          */
+
+
+        /** Re-measure the map and re-fit the page after a layout/size change. */
+        function refitMap() {
+            if (!state.leafletMap || !state.fitBounds) return;
+            state.leafletMap.invalidateSize(false);
+            state.leafletMap.fitBounds(state.fitBounds, { padding: [10, 10], animate: false });
+        }
+        window.addEventListener('resize', () => refitMap());
+
+        /**
+         * Collect region-like elements: TextRegion and TableCell (PAGE table cells
+         * are region-level containers and hold their own TextLine children).
+         * Namespace-safe: matches on localName.
+         */
+        function collectRegions(root) {
+            const out = [];
+            for (const elem of root.querySelectorAll('*')) {
+                const n = elem.localName || elem.tagName;
+                if (n === 'TextRegion' || n === 'TableCell') out.push(elem);
+            }
+            return out;
+        }
+
+        /** Human label for a region: table cells get row/col + structure type. */
+        function regionLabel(region) {
+            const n = region.localName || region.tagName;
+            const id = region.getAttribute('id') || 'unknown';
+            if (n !== 'TableCell') return `Text region - ${id}`;
+            const row = region.getAttribute('row'), col = region.getAttribute('col');
+            const m = /structure\s*\{[^}]*type:([^;}]+)/.exec(region.getAttribute('custom') || '');
+            const type = m ? m[1].trim() : '';
+            return `Cell r${row} c${col}${type ? ' - ' + type : ''}`;
+        }
+
+        /** All descendant TextLines of a region. */
+        function collectLines(region) {
+            const out = [];
+            for (const elem of region.querySelectorAll('*')) {
+                const n = elem.localName || elem.tagName;
+                if (n === 'TextLine') out.push(elem);
+            }
+            return out;
+        }
+
+        /** First Coords *child* of an element (not of its descendants). */
+        function ownCoords(elem) {
+            for (const c of elem.children) {
+                if ((c.localName || c.tagName) === 'Coords') return c;
+            }
+            return null;
+        }
+
+        /** Parse a PAGE points string into Leaflet [lat,lng] with Y inverted. */
+        function parsePoints(pointsStr, imageHeight) {
+            if (!pointsStr) return [];
+            return pointsStr.trim().split(/\s+/).map(p => {
+                const parts = p.split(',');
+                if (parts.length !== 2) return null;
+                const x = parseFloat(parts[0]), y = parseFloat(parts[1]);
+                if (!isFinite(x) || !isFinite(y)) return null;
+                return [imageHeight - y, x];
+            }).filter(Boolean);
+        }
